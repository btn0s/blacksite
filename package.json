{
  "name": "blacksite",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm dev:site",
    "dev:site": "vite --config site/vite.config.ts",
    "build": "tsc --noEmit && pnpm build:site",
    "build:site": "vite build --config site/vite.config.ts",
    "meta:images": "tsx scripts/meta-images.ts",
    "preview:site": "vite preview --config site/vite.config.ts --host 0.0.0.0",
    "build:asset-ports": "node scripts/build-asset-ports.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:training": "python3 -m unittest discover -s tests -p 'training_preflight_test.py'",
    "check:boundaries": "tsx scripts/check-boundaries.ts",
    "scenarios": "tsx scripts/run-scenarios.ts",
    "benchmark:cascade:scale": "tsx scripts/benchmark-cascade-scale.ts",
    "benchmark": "tsx scripts/benchmark.ts",
    "layouts": "tsx scripts/evaluate-layouts.ts",
    "dogleg:report": "tsx scripts/analyze-dogleg.ts",
    "counterfactual": "tsx scripts/counterfactual.ts",
    "replay:verify": "tsx scripts/verify-replay.ts",
    "server": "tsx packages/server/src/index.ts",
    "bake": "tsx scripts/bake-map.ts",
    "test:warden": "vitest run",
    "test:cascade": "vitest run tests/destruction tests/destruction-host-physics.test.ts",
    "dev:warden": "vite --host 0.0.0.0"
  },
  "dependencies": {
    "@blacksite/armory": "workspace:*",
    "@blacksite/cascade": "workspace:*",
    "@blacksite/check": "workspace:*",
    "@blacksite/example-breach": "workspace:*",
    "@blacksite/input": "workspace:*",
    "@blacksite/look": "workspace:*",
    "@blacksite/relay": "workspace:*",
    "@blacksite/subject": "workspace:*",
    "@blacksite/subject-fpp": "workspace:*",
    "@blacksite/ui": "workspace:*",
    "@dimforge/rapier3d-compat": "file:vendor/rapier/rapier3d-compat-0.19.2-rupture.4.tgz",
    "@dimforge/rapier3d-simd-compat": "file:vendor/rapier/rapier3d-simd-compat-0.19.2-rupture.4.tgz",
    "@gltf-transform/core": "^4.5.1",
    "@gltf-transform/extensions": "^4.5.1",
    "@gltf-transform/functions": "^4.5.1",
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.2",
    "@react-three/postprocessing": "^3.1.3",
    "@react-three/rapier": "^2.2.0",
    "als-ue5-r3f": "workspace:*",
    "effect": "^3.19.0",
    "koota": "^0.6.0",
    "ktx2-encoder": "^0.6.0",
    "leva": "^0.10.1",
    "lucide-react": "^1.55.0",
    "meshoptimizer": "^1.3.0",
    "navcat": "^0.4.1",
    "postprocessing": "^6.39.5",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "three": "^0.186.1",
    "ws": "^8.18.3",
    "xstate": "^5.23.0",
    "yauzl": "^3.4.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@fontsource/barlow": "^5.3.0",
    "@fontsource/barlow-condensed": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@mdx-js/react": "^3.1.1",
    "@mdx-js/rollup": "^3.1.1",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/three": "^0.186.0",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^5.0.0",
    "esbuild": "^0.28.2",
    "opentype.js": "^2.0.0",
    "oxlint": "^1.86.0",
    "rapier-host": "npm:@dimforge/rapier3d-compat@^0.21.0",
    "remark-gfm": "^4.0.1",
    "sharp": "^0.35.5",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^4.1.11"
  },
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=22.12"
  },
  "license": "FSL-1.1-ALv2"
