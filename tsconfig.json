{
  "compilerOptions": {
    "target": "ES2022", "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext", "moduleResolution": "Bundler", "jsx": "react-jsx",
    "strict": true, "noEmit": true, "allowImportingTsExtensions": true, "skipLibCheck": true,
    "esModuleInterop": true, "resolveJsonModule": true,
    "types": ["vite/client", "node"],
    "baseUrl": ".", "paths": { "@blacksite/*": ["packages/*/src/index.ts"] }
  },
  "include": ["packages", "scripts", "tests", "site", "vendor/als-web/src/app/globals.d.ts"]
}
