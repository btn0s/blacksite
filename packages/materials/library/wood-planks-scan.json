{
  "name": "wood-planks-scan",
  "title": "Weathered planks",
  "description": "Planks002 CC0 scan (https://ambientcg.com/view?id=Planks002), delit, with weather that follows the scan's height: dirt in cavities, wear on edges, damp in low areas.",
  "size": 1,
  "depth": 0.01,
  "seed": 1,
  "orientation": "wall",
  "nodes": {
    "photo": {
      "op": "image",
      "src": "../scans/wood-planks/color.webp"
    },
    "albedo": {
      "op": "delight",
      "input": "photo",
      "radius": 0.3,
      "strength": 0.5
    },
    "heightmap": {
      "op": "image",
      "src": "../scans/wood-planks/height.webp"
    },
    "height": {
      "op": "channel",
      "input": "heightmap",
      "channel": "r"
    },
    "normalmap": {
      "op": "image",
      "src": "../scans/wood-planks/normal.webp"
    },
    "roughnessmap": {
      "op": "image",
      "src": "../scans/wood-planks/roughness.webp"
    },
    "roughness": {
      "op": "channel",
      "input": "roughnessmap",
      "channel": "r"
    }
  },
  "outputs": {
    "color": "albedo",
    "height": "height",
    "normal": "normalmap",
    "roughness": "roughness",
    "metalness": 0
  },
  "finish": {
    "ao": {
      "strength": 0
    }
  },
  "weather": {
    "age": 0.35,
    "dirt": 0.35,
    "moisture": 0.15,
    "wear": {
      "amount": 0.25,
      "color": "#9a8a78"
    }
  }
}
