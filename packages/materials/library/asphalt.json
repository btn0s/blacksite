{
  "name": "asphalt",
  "title": "Worn asphalt",
  "description": "Hot-rolled asphalt with the binder worn back from the aggregate, fine crazing and patched cracks.",
  "size": 3.0,
  "depth": 0.006,
  "seed": 8,
  "orientation": "floor",
  "porosity": 0.6,
  "nodes": {
    "stones": { "op": "cellular", "cell": 0.007, "mode": "f1", "jitter": 1 },
    "stoneId": { "op": "cellular", "cell": 0.007, "mode": "id", "jitter": 1 },
    "grit": { "op": "cellular", "cell": 0.0025, "mode": "f1" },
    "wearField": { "op": "fbm", "cell": 0.5, "octaves": 5 },
    "stoneH": { "op": "levels", "input": "stones", "in": [0.75, 0.1] },
    "gritH": { "op": "levels", "input": "grit", "in": [0.8, 0.1] },
    "aggr": { "op": "blend", "a": "stoneH", "b": "gritH", "mode": "max", "opacity": 0.6 },
    "binderLevel": { "op": "levels", "input": "wearField", "out": [0.45, 0.75] },
    "relief": { "op": "blend", "a": "binderLevel", "b": "aggr", "mode": "max" },
    "cracks": { "op": "cellular", "cell": 0.9, "mode": "edge" },
    "crackW": { "op": "fbm", "cell": 0.15, "octaves": 4 },
    "crackWarped": { "op": "warp", "input": "cracks", "by": "crackW", "amount": 0.06 },
    "crack": { "op": "levels", "input": "crackWarped", "in": [0.02, 0.0] },
    "crackSel": { "op": "fbm", "cell": 1.0, "octaves": 3 },
    "crackKeep": { "op": "levels", "input": "crackSel", "in": [0.45, 0.55] },
    "crackM": { "op": "blend", "a": "crack", "b": "crackKeep", "mode": "multiply" },
    "height": { "op": "blend", "a": "relief", "b": "crackM", "mode": "subtract", "opacity": 0.6 },
    "stoneTone": { "op": "ramp", "input": "stoneId", "stops": [[0, "#5d5b56"], [0.4, "#6e6b64"], [0.7, "#7f7b72"], [0.9, "#8f8a7e"], [1, "#9a9284"]] },
    "exposed": { "op": "blend", "a": "aggr", "b": "binderLevel", "mode": "subtract" },
    "exposedM": { "op": "levels", "input": "exposed", "in": [-0.05, 0.1] },
    "binder": { "op": "ramp", "input": "wearField", "stops": [[0, "#262523"], [1, "#3b3936"]] },
    "color0": { "op": "blend", "a": "binder", "b": "stoneTone", "mode": "mix", "mask": "exposedM" },
    "color": { "op": "blend", "a": "color0", "b": "#161514", "mode": "mix", "mask": "crackM", "opacity": 0.85 },
    "roughness": { "op": "blend", "a": 0.88, "b": 0.95, "mode": "mix", "mask": "exposedM" }
  },
  "outputs": { "color": "color", "height": "height", "roughness": "roughness", "metalness": 0 },
  "finish": { "normal": 1, "ao": { "radius": 0.01, "strength": 0.8 } },
  "weather": { "age": 0.6, "dirt": 0.3 }
}
