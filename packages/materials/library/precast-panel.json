{
  "name": "precast-panel",
  "title": "Precast concrete panel",
  "description": "Steel-form cast wall panel with sealed joints, fine blowholes and a mottled skin.",
  "size": 3.0,
  "depth": 0.01,
  "seed": 2,
  "orientation": "wall",
  "nodes": {
    "panel": { "op": "panels", "tile": [3.0, 3.0], "gap": 0.022, "bevel": 0.012 },
    "joint": { "op": "panels", "tile": [3.0, 3.0], "gap": 0.022, "bevel": 0.012, "output": "mask" },
    "mottle": { "op": "fbm", "cell": 0.5, "octaves": 6, "gain": 0.55 },
    "skin": { "op": "fbm", "cell": 0.05, "octaves": 4, "gain": 0.5 },
    "fine": { "op": "fbm", "cell": 0.004, "octaves": 2, "basis": "value" },
    "pores": { "op": "scatter", "cell": 0.02, "radius": 0.0025, "sizeJitter": 0.6, "density": 0.4, "shape": "crater" },
    "big": { "op": "scatter", "cell": 0.09, "radius": 0.006, "sizeJitter": 0.5, "density": 0.35, "shape": "chip" },
    "mastic": { "op": "fbm", "cell": 0.01, "octaves": 3 },
    "surface": { "op": "blend", "a": 0.75, "b": "skin", "mode": "overlay", "opacity": 0.35 },
    "surface2": { "op": "blend", "a": "surface", "b": "fine", "mode": "overlay", "opacity": 0.25 },
    "surface3": { "op": "blend", "a": "surface2", "b": "pores", "mode": "subtract", "opacity": 0.5 },
    "surface4": { "op": "blend", "a": "surface3", "b": "big", "mode": "subtract", "opacity": 0.4 },
    "jointH": { "op": "levels", "input": "mastic", "out": [0.18, 0.28] },
    "height": { "op": "blend", "a": "jointH", "b": "surface4", "mode": "mix", "mask": "panel" },
    "tone": { "op": "blend", "a": "mottle", "b": "skin", "mode": "overlay", "opacity": 0.5 },
    "concrete": { "op": "ramp", "input": "tone", "stops": [[0, "#716e66"], [0.45, "#94918a"], [0.7, "#a6a399"], [1, "#b9b5aa"]] },
    "pitted": { "op": "blend", "a": "concrete", "b": "#3a3833", "mode": "mix", "mask": "pores", "opacity": 0.7 },
    "pitted2": { "op": "blend", "a": "pitted", "b": "#4a4740", "mode": "mix", "mask": "big", "opacity": 0.6 },
    "masticC": { "op": "ramp", "input": "mastic", "stops": [[0, "#22211e"], [1, "#3a3833"]] },
    "color": { "op": "blend", "a": "masticC", "b": "pitted2", "mode": "mix", "mask": "joint" },
    "roughC": { "op": "levels", "input": "skin", "out": [0.82, 0.95] },
    "roughness": { "op": "blend", "a": 0.7, "b": "roughC", "mode": "mix", "mask": "joint" }
  },
  "outputs": { "color": "color", "height": "height", "roughness": "roughness", "metalness": 0 },
  "finish": { "normal": 1, "ao": { "radius": 0.03, "strength": 0.85 } },
  "weather": { "age": 0.6, "dirt": 0.45 }
}
