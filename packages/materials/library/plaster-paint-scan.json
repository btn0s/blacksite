{
  "name": "plaster-paint-scan",
  "title": "Peeling painted plaster",
  "description": "PaintedPlaster018 CC0 scan (https://ambientcg.com/view?id=PaintedPlaster018), delit, with weather that follows the scan's height: dirt in cavities, wear on edges, damp in low areas.",
  "size": 3.0,
  "depth": 0.006,
  "seed": 1,
  "orientation": "wall",
  "nodes": {
    "photo": {
      "op": "image",
      "src": "../scans/plaster-paint/color.webp",
      "repeat": [
        2,
        2
      ]
    },
    "albedo": {
      "op": "delight",
      "input": "photo",
      "radius": 0.45,
      "strength": 0.5
    },
    "heightmap": {
      "op": "image",
      "src": "../scans/plaster-paint/height.webp",
      "repeat": [
        2,
        2
      ]
    },
    "height": {
      "op": "channel",
      "input": "heightmap",
      "channel": "r"
    },
    "normalmap": {
      "op": "image",
      "src": "../scans/plaster-paint/normal.webp",
      "repeat": [
        2,
        2
      ]
    },
    "roughnessmap": {
      "op": "image",
      "src": "../scans/plaster-paint/roughness.webp",
      "repeat": [
        2,
        2
      ]
    },
    "roughness": {
      "op": "channel",
      "input": "roughnessmap",
      "channel": "r"
    },
    "aomap": {
      "op": "image",
      "src": "../scans/plaster-paint/ao.webp",
      "repeat": [
        2,
        2
      ]
    },
    "ao": {
      "op": "channel",
      "input": "aomap",
      "channel": "r"
    }
  },
  "outputs": {
    "color": "albedo",
    "height": "height",
    "normal": "normalmap",
    "roughness": "roughness",
    "metalness": 0,
    "ao": "ao"
  },
  "finish": {
    "ao": {
      "strength": 0
    }
  },
  "weather": {
    "age": 0.7,
    "dirt": 0.45,
    "moisture": 0.15,
    "wear": 0.25
  }
}
