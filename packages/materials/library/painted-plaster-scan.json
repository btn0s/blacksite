{
  "name": "painted-plaster-scan",
  "title": "Painted plaster",
  "description": "PaintedPlaster015 CC0 scan (https://ambientcg.com/view?id=PaintedPlaster015), delit, with weather that follows the scan's height: dirt in cavities, wear on edges, damp in low areas.",
  "size": 2.5,
  "depth": 0.004,
  "seed": 1,
  "orientation": "wall",
  "nodes": {
    "photo": {
      "op": "image",
      "src": "../scans/painted-plaster/color.webp"
    },
    "albedo": {
      "op": "delight",
      "input": "photo",
      "radius": 0.75,
      "strength": 0.5
    },
    "heightmap": {
      "op": "image",
      "src": "../scans/painted-plaster/height.webp"
    },
    "height": {
      "op": "channel",
      "input": "heightmap",
      "channel": "r"
    },
    "normalmap": {
      "op": "image",
      "src": "../scans/painted-plaster/normal.webp"
    },
    "roughnessmap": {
      "op": "image",
      "src": "../scans/painted-plaster/roughness.webp"
    },
    "roughness": {
      "op": "channel",
      "input": "roughnessmap",
      "channel": "r"
    },
    "aomap": {
      "op": "image",
      "src": "../scans/painted-plaster/ao.webp"
    },
    "ao": {
      "op": "channel",
      "input": "aomap",
      "channel": "r"
    }
  },
  "outputs": {
    "color": "albedo",
    "height": "height",
    "normal": "normalmap",
    "roughness": "roughness",
    "metalness": 0,
    "ao": "ao"
  },
  "finish": {
    "ao": {
      "strength": 0
    }
  },
  "weather": {
    "age": 0.45,
    "dirt": 0.35,
    "moisture": 0.2,
    "wear": {
      "amount": 0.35,
      "color": "#8e8c88"
    }
  }
}
