{
  "name": "rust-scan",
  "title": "Rusted steel",
  "description": "Rust009 CC0 scan (https://ambientcg.com/view?id=Rust009), delit, with weather that follows the scan's height: dirt in cavities, wear on edges, damp in low areas.",
  "size": 2,
  "depth": 0.004,
  "seed": 1,
  "orientation": "object",
  "nodes": {
    "photo": {
      "op": "image",
      "src": "../scans/rust/color.webp"
    },
    "albedo": {
      "op": "delight",
      "input": "photo",
      "radius": 0.6,
      "strength": 0.5
    },
    "heightmap": {
      "op": "image",
      "src": "../scans/rust/height.webp"
    },
    "height": {
      "op": "channel",
      "input": "heightmap",
      "channel": "r"
    },
    "normalmap": {
      "op": "image",
      "src": "../scans/rust/normal.webp"
    },
    "roughnessmap": {
      "op": "image",
      "src": "../scans/rust/roughness.webp"
    },
    "roughness": {
      "op": "channel",
      "input": "roughnessmap",
      "channel": "r"
    },
    "aomap": {
      "op": "image",
      "src": "../scans/rust/ao.webp"
    },
    "ao": {
      "op": "channel",
      "input": "aomap",
      "channel": "r"
    }
  },
  "outputs": {
    "color": "albedo",
    "height": "height",
    "normal": "normalmap",
    "roughness": "roughness",
    "metalness": 0,
    "ao": "ao"
  },
  "finish": {
    "ao": {
      "strength": 0
    }
  },
  "weather": {
    "age": 0.5,
    "dirt": 0.45,
    "moisture": 0.15
  }
}
