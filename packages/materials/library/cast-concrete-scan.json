{
  "name": "cast-concrete-scan",
  "title": "Cast concrete",
  "description": "Concrete044D CC0 scan (https://ambientcg.com/view?id=Concrete044D), delit, with weather that follows the scan's height: dirt in cavities, wear on edges, damp in low areas.",
  "size": 2.5,
  "depth": 0.01,
  "seed": 1,
  "orientation": "wall",
  "nodes": {
    "photo": {
      "op": "image",
      "src": "../scans/cast-concrete/color.webp"
    },
    "albedo": {
      "op": "delight",
      "input": "photo",
      "radius": 0.75,
      "strength": 0.5
    },
    "heightmap": {
      "op": "image",
      "src": "../scans/cast-concrete/height.webp"
    },
    "height": {
      "op": "channel",
      "input": "heightmap",
      "channel": "r"
    },
    "normalmap": {
      "op": "image",
      "src": "../scans/cast-concrete/normal.webp"
    },
    "roughnessmap": {
      "op": "image",
      "src": "../scans/cast-concrete/roughness.webp"
    },
    "roughness": {
      "op": "channel",
      "input": "roughnessmap",
      "channel": "r"
    },
    "aomap": {
      "op": "image",
      "src": "../scans/cast-concrete/ao.webp"
    },
    "ao": {
      "op": "channel",
      "input": "aomap",
      "channel": "r"
    }
  },
  "outputs": {
    "color": "albedo",
    "height": "height",
    "normal": "normalmap",
    "roughness": "roughness",
    "metalness": 0,
    "ao": "ao"
  },
  "finish": {
    "ao": {
      "strength": 0
    }
  },
  "weather": {
    "age": 0.4,
    "dirt": 0.35,
    "moisture": 0.2,
    "wear": 0.25
  }
}
