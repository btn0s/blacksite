{
  "name": "precast-panel-scan",
  "title": "Precast concrete units",
  "description": "Concrete013 CC0 scan (https://ambientcg.com/view?id=Concrete013), delit, with weather that follows the scan's height: dirt in cavities, wear on edges, damp in low areas.",
  "size": 3,
  "depth": 0.015,
  "seed": 1,
  "orientation": "wall",
  "nodes": {
    "photo": {
      "op": "image",
      "src": "../scans/precast-panel/color.webp",
      "repeat": [
        1,
        2
      ]
    },
    "albedo": {
      "op": "delight",
      "input": "photo",
      "radius": 0.9,
      "strength": 0.5
    },
    "heightmap": {
      "op": "image",
      "src": "../scans/precast-panel/height.webp",
      "repeat": [
        1,
        2
      ]
    },
    "height": {
      "op": "channel",
      "input": "heightmap",
      "channel": "r"
    },
    "normalmap": {
      "op": "image",
      "src": "../scans/precast-panel/normal.webp",
      "repeat": [
        1,
        2
      ]
    },
    "roughnessmap": {
      "op": "image",
      "src": "../scans/precast-panel/roughness.webp",
      "repeat": [
        1,
        2
      ]
    },
    "roughness": {
      "op": "channel",
      "input": "roughnessmap",
      "channel": "r"
    },
    "aomap": {
      "op": "image",
      "src": "../scans/precast-panel/ao.webp",
      "repeat": [
        1,
        2
      ]
    },
    "ao": {
      "op": "channel",
      "input": "aomap",
      "channel": "r"
    }
  },
  "outputs": {
    "color": "albedo",
    "height": "height",
    "normal": "normalmap",
    "roughness": "roughness",
    "metalness": 0,
    "ao": "ao"
  },
  "finish": {
    "ao": {
      "strength": 0
    }
  },
  "weather": {
    "age": 0.7,
    "dirt": 0.45,
    "moisture": 0.2,
    "wear": 0.25
  }
}
