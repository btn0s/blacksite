{
  "name": "bark-scan",
  "title": "Bark",
  "description": "Bark014 CC0 scan (https://ambientcg.com/view?id=Bark014), delit, with weather that follows the scan's height: dirt in cavities, wear on edges, damp in low areas.",
  "size": 2.4,
  "depth": 0.03,
  "seed": 1,
  "orientation": "object",
  "nodes": {
    "photo": {
      "op": "image",
      "src": "../scans/bark/color.webp",
      "repeat": [
        2,
        2
      ]
    },
    "albedo": {
      "op": "delight",
      "input": "photo",
      "radius": 0.36,
      "strength": 0.5
    },
    "heightmap": {
      "op": "image",
      "src": "../scans/bark/height.webp",
      "repeat": [
        2,
        2
      ]
    },
    "height": {
      "op": "channel",
      "input": "heightmap",
      "channel": "r"
    },
    "normalmap": {
      "op": "image",
      "src": "../scans/bark/normal.webp",
      "repeat": [
        2,
        2
      ]
    },
    "roughnessmap": {
      "op": "image",
      "src": "../scans/bark/roughness.webp",
      "repeat": [
        2,
        2
      ]
    },
    "roughness": {
      "op": "channel",
      "input": "roughnessmap",
      "channel": "r"
    },
    "aomap": {
      "op": "image",
      "src": "../scans/bark/ao.webp",
      "repeat": [
        2,
        2
      ]
    },
    "ao": {
      "op": "channel",
      "input": "aomap",
      "channel": "r"
    }
  },
  "outputs": {
    "color": "albedo",
    "height": "height",
    "normal": "normalmap",
    "roughness": "roughness",
    "metalness": 0,
    "ao": "ao"
  },
  "finish": {
    "ao": {
      "strength": 0
    }
  },
  "weather": {
    "age": 0.4,
    "dirt": 0.3,
    "moisture": 0.2
  }
}
